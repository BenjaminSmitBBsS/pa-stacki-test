---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KaartjeOnline — Digitale Visitekaartjes &amp; Micro-Websites</title>
  <!-- Laad Inter lettertype -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Subtiele animaties voor accordeon en statusmeldingen */
    .accordion-content {
      transition: grid-template-rows 0.28s ease-out;
      display: grid;
      grid-template-rows: 0fr;
    }
    .accordion-item[data-open="true"] .accordion-content {
      grid-template-rows: 1fr;
    }
    .accordion-inner {
      overflow: hidden;
    }
    .accordion-chevron {
      transition: transform 0.25s ease;
    }
    .accordion-item[data-open="true"] .accordion-chevron {
      transform: rotate(180deg);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-indigo-600 selection:text-white">

  <!-- 1. NAVIGATIEBALK -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-20">
        <!-- Merknaam & SVG Logo -->
        <a href="#" class="flex items-center gap-2.5 group focus:outline-none">
          <span class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-sm group-hover:bg-indigo-700 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3"></rect>
              <circle cx="8.5" cy="12" r="2"></circle>
              <path stroke-linecap="round" d="M13.5 10h4M13.5 14h2.5"></path>
            </svg>
          </span>
          <span class="text-lg sm:text-xl font-bold tracking-tight text-slate-900">
            Kaartje<span class="text-indigo-600">Online</span>
          </span>
        </a>

        <!-- Desktop Navigatie -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600" aria-label="Hoofdnavigatie">
          <a href="#hoe-het-werkt" class="hover:text-indigo-600 transition-colors py-2">Hoe het werkt</a>
          <a href="#voorbeelden" class="hover:text-indigo-600 transition-colors py-2">Voorbeelden</a>
          <a href="#prijzen" class="hover:text-indigo-600 transition-colors py-2">Prijzen</a>
          <a href="#faq" class="hover:text-indigo-600 transition-colors py-2">FAQ</a>
        </nav>

        <!-- Desktop CTA & Mobiel Menu Knop -->
        <div class="flex items-center gap-3">
          <a href="#aanvragen" class="hidden sm:inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] shadow-sm transition-all">
            Maak je kaartje
          </a>
          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden p-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
            aria-label="Open navigatiemenu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Uitklapbaar Mobiel Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-5 space-y-1">
      <a href="#hoe-het-werkt" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-100">Hoe het werkt</a>
      <a href="#voorbeelden" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-100">Voorbeelden</a>
      <a href="#prijzen" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-100">Prijzen</a>
      <a href="#faq" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-100">FAQ</a>
      <div class="pt-2">
        <a href="#aanvragen" class="mobile-nav-link w-full inline-flex items-center justify-center px-4 py-3 rounded-xl text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
          Maak je kaartje
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- 2. HERO-SECTIE + INTERACTIEVE LIVE PREVIEW -->
    <section class="relative overflow-hidden pt-10 pb-16 sm:pt-14 sm:pb-24 lg:pt-16 lg:pb-28">
      <!-- Zachte decoratieve achtergrondgloed -->
      <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[900px] h-[420px] rounded-full bg-indigo-100/60 blur-3xl -z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <!-- Linker Kolom: Sterke Nederlandse Kop & Waardebeloofte -->
          <div class="lg:col-span-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-200/80 text-indigo-700 text-xs sm:text-sm font-semibold mb-5">
              <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
              QR-code, NFC &amp; snelle micro-website in één link
            </div>

            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.12]">
              Jouw slimme <span class="text-indigo-600">digitale visitekaartje</span> en razendsnelle mini-website
            </h1>

            <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
              Deel direct al je contactgegevens, portfolio en social links via een persoonlijke link, QR-code of NFC-kaartje. Bezoekers slaan je met één tik op als contactpersoon (vCard), sturen een WhatsApp-bericht, bellen of mailen zonder gedoe.
            </p>

            <!-- Primaire & Secundaire CTA's -->
            <div class="mt-7 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5">
              <a href="#aanvragen" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/20 transition-all">
                Start met jouw kaartje
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>
              <a href="#voorbeelden" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-base font-semibold text-slate-700 bg-white hover:bg-slate-100 border border-slate-200 transition-colors">
                Bekijk voorbeelden
              </a>
            </div>

            <!-- Korte trust-punten -->
            <div class="mt-8 pt-6 border-t border-slate-200/80 grid grid-cols-3 gap-4 text-left max-w-lg mx-auto lg:mx-0">
              <div>
                <p class="text-sm font-bold text-slate-900">1-klik vCard</p>
                <p class="text-xs text-slate-500 mt-0.5">Direct in adresboek</p>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900">Altijd actueel</p>
                <p class="text-xs text-slate-500 mt-0.5">Geen herdrukken meer</p>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900">QR &amp; NFC klaar</p>
                <p class="text-xs text-slate-500 mt-0.5">Werkt op elke telefoon</p>
              </div>
            </div>
          </div>

          <!-- Rechter Kolom: Interactieve Live Preview + Testregelaars -->
          <div class="lg:col-span-6">
            <div class="bg-white rounded-3xl border border-slate-200/90 shadow-lg p-5 sm:p-6">
              <div class="flex items-center justify-between gap-2 pb-4 mb-5 border-b border-slate-100">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Live Playground</span>
                  <h2 class="text-base sm:text-lg font-bold text-slate-900">Test jouw digitale visitekaartje direct</h2>
                </div>
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Live preview
                </span>
              </div>

              <!-- Interactieve invoervelden om het kaartje live aan te passen -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
                <div>
                  <label for="hero-input-naam" class="block text-xs font-semibold text-slate-600 mb-1">Naam</label>
                  <input
                    id="hero-input-naam"
                    type="text"
                    value="Lotte van Dijk"
                    maxlength="40"
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
                    placeholder="Bijv. Lotte van Dijk"
                  />
                </div>
                <div>
                  <label for="hero-input-functie" class="block text-xs font-semibold text-slate-600 mb-1">Functie</label>
                  <input
                    id="hero-input-functie"
                    type="text"
                    value="UX &amp; Brand Designer"
                    maxlength="45"
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
                    placeholder="Bijv. Brand Designer"
                  />
                </div>
                <div>
                  <label for="hero-input-bedrijf" class="block text-xs font-semibold text-slate-600 mb-1">Bedrijf</label>
                  <input
                    id="hero-input-bedrijf"
                    type="text"
                    value="Studio Noord"
                    maxlength="40"
                    class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
                    placeholder="Bijv. Studio Noord"
                  />
                </div>
              </div>

              <!-- Thema-kleur kiezer -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
                <span class="text-xs font-semibold text-slate-600">Kies thema-kleur:</span>
                <div class="flex items-center gap-2" role="group" aria-label="Kies thema-kleur voor live kaartje">
                  <button type="button" data-theme-color="#4f46e5" data-theme-name="Indigo" class="hero-color-btn w-7 h-7 rounded-full bg-indigo-600 ring-2 ring-offset-2 ring-indigo-600 transition-transform hover:scale-110" aria-label="Indigo thema"></button>
                  <button type="button" data-theme-color="#0d9488" data-theme-name="Smaragd" class="hero-color-btn w-7 h-7 rounded-full bg-teal-600 ring-offset-2 hover:ring-2 hover:ring-teal-600 transition-transform hover:scale-110" aria-label="Smaragd thema"></button>
                  <button type="button" data-theme-color="#e11d48" data-theme-name="Koraalrood" class="hero-color-btn w-7 h-7 rounded-full bg-rose-600 ring-offset-2 hover:ring-2 hover:ring-rose-600 transition-transform hover:scale-110" aria-label="Koraalrood thema"></button>
                  <button type="button" data-theme-color="#d97706" data-theme-name="Amber" class="hero-color-btn w-7 h-7 rounded-full bg-amber-600 ring-offset-2 hover:ring-2 hover:ring-amber-600 transition-transform hover:scale-110" aria-label="Amber thema"></button>
                  <button type="button" data-theme-color="#0f172a" data-theme-name="Nachtblauw" class="hero-color-btn w-7 h-7 rounded-full bg-slate-900 ring-offset-2 hover:ring-2 hover:ring-slate-900 transition-transform hover:scale-110" aria-label="Nachtblauw thema"></button>
                </div>
              </div>

              <!-- Het Digitale Visitekaartje (Mobiele Micro-Website Mockup) -->
              <div class="bg-slate-100/90 rounded-2xl p-4 sm:p-5 border border-slate-200/70">
                <div class="max-w-sm mx-auto bg-white rounded-2xl shadow-md overflow-hidden border border-slate-200/80">
                  <!-- Banner & Avatar -->
                  <div id="hero-card-banner" class="h-20 relative transition-colors duration-300" style="background-color: #4f46e5;">
                    <div class="absolute top-3 right-3 bg-white/20 backdrop-blur-sm text-white text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                      kaartjeonline.nl/lotte
                    </div>
                  </div>
                  <div class="px-5 pb-5">
                    <div class="-mt-9 mb-3 flex items-end justify-between">
                      <div id="hero-card-avatar" class="w-16 h-16 rounded-2xl text-white font-bold text-xl flex items-center justify-center ring-4 ring-white shadow-md transition-colors duration-300" style="background-color: #4f46e5;">
                        LD
                      </div>
                      <button
                        id="hero-vcard-btn"
                        type="button"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-white shadow-sm transition-all active:scale-95"
                        style="background-color: #4f46e5;"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Opslaan als vCard
                      </button>
                    </div>

                    <h3 id="hero-card-naam" class="text-lg font-bold text-slate-900 leading-snug">Lotte van Dijk</h3>
                    <p id="hero-card-functie" class="text-sm font-medium text-slate-600">UX &amp; Brand Designer</p>
                    <p id="hero-card-bedrijf" class="text-xs font-semibold uppercase tracking-wide text-slate-400 mt-0.5">Studio Noord</p>

                    <!-- Directe contactacties: WhatsApp, Bellen, E-mail -->
                    <div class="grid grid-cols-3 gap-2 mt-4">
                      <button type="button" data-action-label="WhatsApp-gesprek gestart met" class="hero-quick-action flex flex-col items-center justify-center py-2.5 px-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200/70 text-slate-700 transition-colors">
                        <svg class="w-4 h-4 text-emerald-600 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <span class="text-[11px] font-semibold">WhatsApp</span>
                      </button>

                      <button type="button" data-action-label="Belactie voorbereid voor" class="hero-quick-action flex flex-col items-center justify-center py-2.5 px-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200/70 text-slate-700 transition-colors">
                        <svg class="w-4 h-4 text-indigo-600 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                        <span class="text-[11px] font-semibold">Bellen</span>
                      </button>

                      <button type="button" data-action-label="E-mailvenster geopend voor" class="hero-quick-action flex flex-col items-center justify-center py-2.5 px-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200/70 text-slate-700 transition-colors">
                        <svg class="w-4 h-4 text-sky-600 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        <span class="text-[11px] font-semibold">E-mail</span>
                      </button>
                    </div>

                    <!-- Micro-website links & QR badge -->
                    <div class="mt-3.5 pt-3.5 border-t border-slate-100 flex items-center justify-between gap-2">
                      <div class="flex items-center gap-2 text-xs text-slate-500">
                        <span class="p-1.5 rounded-lg bg-slate-100 text-slate-700">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                          </svg>
                        </span>
                        <span>Inclusief QR &amp; NFC</span>
                      </div>
                      <span class="text-xs font-semibold text-indigo-600">Portfolio &rarr;</span>
                    </div>
                  </div>
                </div>

                <!-- Feedback-balk voor klikken op knoppen in de preview -->
                <div id="hero-preview-feedback" class="mt-3 text-center text-xs font-medium text-slate-600 min-h-[1.25rem]" aria-live="polite"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VOORDELEN / HOE HET WERKT -->
    <section id="hoe-het-werkt" class="py-16 sm:py-24 bg-white border-y border-slate-200/70">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-14">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Waarom digitaal slimmer is</span>
          <h2 class="mt-2 text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
            Beter dan een papieren kaartje. Sneller dan een zware website.
          </h2>
          <p class="mt-3 text-base sm:text-lg text-slate-600">
            Een papieren visitekaartje verdwijnt vaak in een la. Met een digitaal visitekaartje en micro-website maak je direct indruk en blijf je moeiteloos bereikbaar.
          </p>
        </div>

        <!-- 4 Kernvoordelen -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200/70 hover:border-indigo-200 hover:shadow-md transition-all">
            <div class="w-11 h-11 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Altijd actueel</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Nieuwe functie, ander telefoonnummer of verse actie? Pas het binnen seconden aan zonder dat oude QR-codes of links verlopen.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200/70 hover:border-indigo-200 hover:shadow-md transition-all">
            <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900">QR-code &amp; deellink</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Deel via een korte link in je LinkedIn-bio, e-mailhandtekening, WhatsApp of laat iemand direct je QR-code scannen aan tafel.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200/70 hover:border-indigo-200 hover:shadow-md transition-all">
            <div class="w-11 h-11 rounded-xl bg-sky-100 text-sky-600 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Directe contactacties</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
