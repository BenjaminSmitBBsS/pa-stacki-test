      <p class="text-slate-400">Digitale visitekaartjes &amp; micro-websites</p>
    </div>
  </footer>

  <script>
    // Mobiel menu toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.toggle('hidden');
        mobileBtn.setAttribute('aria-expanded', String(!isHidden));
        iconOpen?.classList.toggle('hidden', !isHidden);
        iconClose?.classList.toggle('hidden', isHidden);
      });
    }

    // Live preview invoervelden
    const naamInput = document.getElementById('hero-input-naam');
    const functieInput = document.getElementById('hero-input-functie');
    const bedrijfInput = document.getElementById('hero-input-bedrijf');
    const cardNaam = document.getElementById('hero-card-naam');
    const cardFunctie = document.getElementById('hero-card-functie');
    const cardBedrijf = document.getElementById('hero-card-bedrijf');
    const cardAvatar = document.getElementById('hero-card-avatar');
    const cardBanner = document.getElementById('hero-card-banner');
    const vcardBtn = document.getElementById('hero-vcard-btn');
    const feedbackEl = document.getElementById('hero-preview-feedback');

    function updatePreview() {
      const naam = (naamInput?.value || 'Lotte van Dijk').trim() || 'Lotte van Dijk';
      const functie = (functieInput?.value || 'UX & Brand Designer').trim() || 'UX & Brand Designer';
      const bedrijf = (bedrijfInput?.value || 'Studio Noord').trim() || 'Studio Noord';

      if (cardNaam) cardNaam.textContent = naam;
      if (cardFunctie) cardFunctie.textContent = functie;
      if (cardBedrijf) cardBedrijf.textContent = bedrijf;

      if (cardAvatar) {
        const parts = naam.split(/\s+/).filter(Boolean);
        const initials = parts.length >= 2
          ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
          : naam.slice(0, 2).toUpperCase();
        cardAvatar.textContent = initials || 'KO';
      }
    }

    naamInput?.addEventListener('input', updatePreview);
    functieInput?.addEventListener('input', updatePreview);
    bedrijfInput?.addEventListener('input', updatePreview);

    // Thema-kleuren
    document.querySelectorAll('.hero-color-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const color = btn.getAttribute('data-theme-color') || '#4f46e5';
        if (cardBanner) cardBanner.style.backgroundColor = color;
        if (cardAvatar) cardAvatar.style.backgroundColor = color;
        if (vcardBtn) vcardBtn.style.backgroundColor = color;
      });
    });

    // Snelle acties in de preview
    document.querySelectorAll('.hero-quick-action').forEach((btn) => {
      btn.addEventListener('click', () => {
        const label = btn.getAttribute('data-action-label') || 'Actie uitgevoerd voor';
        const naam = cardNaam?.textContent || 'Lotte van Dijk';
        if (feedbackEl) feedbackEl.textContent = `${label} ${naam}.`;
      });
    });

    vcardBtn?.addEventListener('click', () => {
      const naam = cardNaam?.textContent || 'Lotte van Dijk';
      if (feedbackEl) feedbackEl.textContent = `vCard voor ${naam} staat klaar om op te slaan.`;
    });

    // FAQ accordeon
    document.querySelectorAll('.accordion-item button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.accordion-item');
        if (!item) return;
        const isOpen = item.getAttribute('data-open') === 'true';
        item.setAttribute('data-open', String(!isOpen));
      });
    });
  </script>
